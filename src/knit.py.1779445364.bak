#!/usr/bin/env python3
import sys
import json
import re

STITCHES = {'k', 'p', 'yo', 'k2tog', 'ssk', 'inc', 'dec'}
KEYWORDS = {'pattern', 'cast_on', 'row', 'repeat', 'bind_off'}

def strip_comments(line):
    in_quote = False
    for i, ch in enumerate(line):
        if ch == '"':
            in_quote = not in_quote
        elif ch == '#' and not in_quote:
            return line[:i]
    return line

def parse_line(line, line_num):
    original = line
    line = strip_comments(line)
    stripped = line.strip()
    if not stripped:
        return ('empty', None, None)
    
    # Check for keyword at start with token boundary
    match = re.match(r'([a-zA-Z_][a-zA-Z0-9_]*)', stripped)
    if not match:
        return ('unknown', None, 'UNKNOWN_STATEMENT')
    keyword = match.group(1)
    rest = stripped[match.end():]
    
    if keyword not in KEYWORDS:
        return ('unknown', None, 'UNKNOWN_STATEMENT')
    
    if keyword == 'pattern':
        # pattern must be followed by whitespace and then a quoted string
        if not rest.startswith(' '):
            return ('unknown', None, 'UNKNOWN_STATEMENT')
        rest = rest.lstrip()
        if not rest.startswith('"'):
            return ('malformed_pattern', None, 'MALFORMED_PATTERN')
        # find closing quote
        end_quote = rest.find('"', 1)
        if end_quote == -1:
            return ('malformed_pattern', None, 'MALFORMED_PATTERN')
        name = rest[1:end_quote]
        after = rest[end_quote+1:].strip()
        if after:
            return ('malformed_pattern', None, 'MALFORMED_PATTERN')
        return ('pattern', name, None)
    
    elif keyword == 'cast_on':
        if not rest.startswith(' '):
            return ('unknown', None, 'UNKNOWN_STATEMENT')
        rest = rest.lstrip()
        if not rest.isdigit():
            return ('malformed_cast_on', None, 'MALFORMED_CAST_ON')
        num = int(rest)
        # check for trailing non-digit
        if not rest.isdigit():
            return ('malformed_cast_on', None, 'MALFORMED_CAST_ON')
        return ('cast_on', num, None)
    
    elif keyword == 'row':
        # row <number>: <stitches>
        if not rest.startswith(' '):
            return ('unknown', None, 'UNKNOWN_STATEMENT')
        rest = rest.lstrip()
        match_row = re.match(r'(\d+):\s*(.*)', rest)
        if not match_row:
            return ('malformed_row', None, 'MALFORMED_ROW')
        row_num = int(match_row.group(1))
        stitch_str = match_row.group(2).strip()
        if not stitch_str:
            return ('malformed_row', None, 'MALFORMED_ROW')
        # parse stitches
        stitches = []
        parts = stitch_str.split(',')
        for part in parts:
            part = part.strip()
            if not part:
                return ('malformed_row', None, 'MALFORMED_ROW')
            # match stitch operation
            st_match = re.match(r'([a-z]+)(\d*)', part)
            if not st_match:
                return ('malformed_row', None, 'MALFORMED_ROW')
            op = st_match.group(1)
            count_str = st_match.group(2)
            if op not in STITCHES:
                return ('unknown_stitch', None, 'UNKNOWN_STITCH')
            count = int(count_str) if count_str else 1
            stitches.append((op, count))
            # check for extra characters after the stitch
            after_stitch = part[st_match.end():].strip()
            if after_stitch:
                return ('malformed_row', None, 'MALFORMED_ROW')
        return ('row', (row_num, stitches), None)
    
    elif keyword == 'repeat':
        # repeat rows <start>-<end> x<count>
        if not rest.startswith(' '):
            return ('unknown', None, 'UNKNOWN_STATEMENT')
        rest = rest.lstrip()
        match_rep = re.match(r'rows\s+(\d+)\s*-\s*(\d+)\s+x(\d+)\s*$', rest)
        if not match_rep:
            return ('malformed_repeat', None, 'MALFORMED_REPEAT')
        start = int(match_rep.group(1))
        end = int(match_rep.group(2))
        count = int(match_rep.group(3))
        return ('repeat', (start, end, count), None)
    
    elif keyword == 'bind_off':
        if rest.strip():
            return ('malformed_bind_off', None, 'MALFORMED_BIND_OFF')
        return ('bind_off', None, None)
    
    return ('unknown', None, 'UNKNOWN_STATEMENT')

def parse_file(filename):
    with open(filename, 'r') as f:
        lines = f.readlines()
    
    statements = []
    errors = []
    for i, line in enumerate(lines):
        line_num = i + 1
        stmt_type, data, error = parse_line(line, line_num)
        if stmt_type == 'empty':
            continue
        if error:
            errors.append({'line': line_num, 'message': error})
        else:
            statements.append({'type': stmt_type, 'data': data, 'line': line_num})
    return statements, errors, len(lines)

def validate(statements, errors):
    # Check for required statements
    has_pattern = any(s['type'] == 'pattern' for s in statements)
    has_cast_on = any(s['type'] == 'cast_on' for s in statements)
    has_bind_off = any(s['type'] == 'bind_off' for s in statements)
    
    if not has_pattern:
        errors.append({'line': 0, 'message': 'MISSING_PATTERN'})
    if not has_cast_on:
        errors.append({'line': 0, 'message': 'MISSING_CAST_ON'})
    if not has_bind_off:
        errors.append({'line': 0, 'message': 'MISSING_BIND_OFF'})
    
    # Check for duplicate pattern
    pattern_count = sum(1 for s in statements if s['type'] == 'pattern')
    if pattern_count > 1:
        errors.append({'line': 0, 'message': 'DUPLICATE_PATTERN'})
    
    # Check for duplicate cast_on
    cast_on_count = sum(1 for s in statements if s['type'] == 'cast_on')
    if cast_on_count > 1:
        errors.append({'line': 0, 'message': 'DUPLICATE_CAST_ON'})
    
    # Check for duplicate bind_off
    bind_off_count = sum(1 for s in statements if s['type'] == 'bind_off')
    if bind_off_count > 1:
        errors.append({'line': 0, 'message': 'DUPLICATE_BIND_OFF'})
    
    # Check for rows after bind_off
    bind_off_line = None
    for s in statements:
        if s['type'] == 'bind_off':
            bind_off_line = s['line']
            break
    if bind_off_line:
        for s in statements:
            if s['type'] == 'row' and s['line'] > bind_off_line:
                errors.append({'line': s['line'], 'message': 'ROW_AFTER_BIND_OFF'})
    
    # Check for rows before cast_on
    cast_on_line = None
    for s in statements:
        if s['type'] == 'cast_on':
            cast_on_line = s['line']
            break
    if cast_on_line:
        for s in statements:
            if s['type'] == 'row' and s['line'] < cast_on_line:
                errors.append({'line': s['line'], 'message': 'ROW_BEFORE_CAST_ON'})
    
    # Check for repeat before any rows
    first_row_line = None
    for s in statements:
        if s['type'] == 'row':
            first_row_line = s['line']
            break
    if first_row_line:
        for s in statements:
            if s['type'] == 'repeat' and s['line'] < first_row_line:
                errors.append({'line': s['line'], 'message': 'REPEAT_BEFORE_ROW'})
    
    # Check for repeat referencing non-existent rows
    row_numbers = set()
    for s in statements:
        if s['type'] == 'row':
            row_numbers.add(s['data'][0])
    for s in statements:
        if s['type'] == 'repeat':
            start, end, _ = s['data']
            for r in range(start, end+1):
                if r not in row_numbers:
                    errors.append({'line': s['line'], 'message': 'REPEAT_REFERENCE_MISSING_ROW'})
                    break

def expand(statements):
    # Build a list of rows in order, expanding repeats
    rows = []
    for s in statements:
        if s['type'] == 'row':
            rows.append(s)
        elif s['type'] == 'repeat':
            start, end, count = s['data']
            # Find the rows with those numbers
            repeated_rows = [r for r in rows if r['data'][0] >= start and r['data'][0] <= end]
            for _ in range(count):
                for r in repeated_rows:
                    rows.append(r)
    return rows

def simulate(rows, cast_on_count):
    stitch_count = cast_on_count
    row_data = []
    for r in rows:
        row_num, stitches = r['data']
        for op, count in stitches:
            if op == 'k' or op == 'p':
                # these don't change count
                pass
            elif op == 'yo':
                stitch_count += count
            elif op == 'k2tog' or op == 'ssk' or op == 'dec':
                stitch_count -= count
            elif op == 'inc':
                stitch_count += count
        row_data.append({'row_number': row_num, 'stitch_count': stitch_count})
    return row_data

def main():
    if len(sys.argv) != 2:
        print("Usage: knit.py <file.knit>", file=sys.stderr)
        sys.exit(1)
    
    filename = sys.argv[1]
    statements, errors, total_lines = parse_file(filename)
    
    # Validate
    validate(statements, errors)
    
    # Determine validity
    valid = len(errors) == 0
    
    # Extract pattern name
    pattern_name = None
    for s in statements:
        if s['type'] == 'pattern':
            pattern_name = s['data']
            break
    
    # Extract cast_on
    cast_on = None
    for s in statements:
        if s['type'] == 'cast_on':
            cast_on = s['data']
            break
    
    # Expand repeats
    expanded_rows = expand(statements)
    
    # Simulate
    if cast_on is not None:
        row_data = simulate(expanded_rows, cast_on)
        final_stitch_count = row_data[-1]['stitch_count'] if row_data else cast_on
    else:
        row_data = []
        final_stitch_count = None
    
    # Build output
    output = {
        'pattern_name': pattern_name,
        'cast_on': cast_on,
        'bind_off': any(s['type'] == 'bind_off' for s in statements),
        'valid': valid,
        'errors': errors,
        'expanded_rows': row_data,
        'final_stitch_count': final_stitch_count
    }
    
    print(json.dumps(output, indent=2))

if __name__ == '__main__':
    main()
